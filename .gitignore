# Real data never enters this repo. Work files live in data/ locally only.
# webapp/d7.html is index.html with the real master sheet snapshot baked in
# by tools/embed_master.py; it must stay out too.
webapp/d7*.html
data/
*.xlsx
*.db
*.har
*.csv
listings*.txt
node_modules/
__pycache__/
.DS_Store
# The synthetic demo set is the one exception.
!demo/*.xlsx
!demo/*.csv
